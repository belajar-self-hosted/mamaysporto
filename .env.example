# =============================================
# Environment Variables for Vercel Deployment
# =============================================
# Copy values ini ke Vercel Dashboard > Settings > Environment Variables

# OpenRouter API Key (untuk AI Chat)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase (dipakai oleh client React/Solid DAN oleh api/chat.js di server
# untuk mengambil AI system prompt dinamis dari tabel site_settings)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
