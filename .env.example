# ========================================================
# Environment Variables for mamaysporto (LXC 10018)
# ========================================================
# Copy file ini ke .env di direktori server /opt/mamaysporto/.env
# dan sesuaikan kredensial rahasia.

# Application Runtime
PORT=3000
NODE_ENV=production

# Database Credentials (PostgreSQL 16)
POSTGRES_DB=mamaysporto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_db_yang_kuat

# JWT Secret untuk Autentikasi Admin CMS
# Buat string acak (misal via `openssl rand -hex 32`)
JWT_SECRET=ganti_dengan_jwt_secret_acak_minimal_32_karakter
