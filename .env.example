# Salin ke .env dan isi secret sebelum menjalankan Docker Compose.
# Gunakan string hex acak agar aman dipakai pada DATABASE_URL tanpa URL encoding.
# Contoh pembuatannya: openssl rand -hex 32

POSTGRES_DB=mamaysporto
POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<hasil openssl rand -hex 32>

APP_DB_USER=mamaysporto_app
# APP_DB_PASSWORD=<hasil openssl rand -hex 32>

# JWT_SECRET harus berbeda dari password database dan minimal 32 karakter acak.
# JWT_SECRET=<hasil openssl rand -hex 32>

# Hanya IP proxy Traefik yang boleh dipakai untuk menafsirkan X-Forwarded-For.
# Sesuaikan jika alamat LXC gateway berubah; jangan isi subnet yang tidak tepercaya.
TRUSTED_PROXY_IPS=192.168.0.80

# Untuk `npm run dev` di host, arahkan ke database Compose pada localhost.
# Password hex yang sama digunakan untuk APP_DB_PASSWORD.
# DATABASE_URL=postgresql://mamaysporto_app:<APP_DB_PASSWORD>@localhost:5432/mamaysporto
# MIGRATION_DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/mamaysporto

PORT=3000
NODE_ENV=development
POSTGRES_PORT=5432
